{
  "manifest_version": 3,
  "name": "Schatten",
  "version": "1.0.0",
  "description": "Learn German with YouTube: the script appears next to the video for shadowing, click any word for its meaning, and unknown words are saved to flashcards automatically.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/book128.png"
    }
  },
  "icons": {
    "128": "icons/book128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["js/injected.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["js/i18n.js", "js/data.js", "js/core.js", "js/store.js", "js/content.js"],
      "css": ["css/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
